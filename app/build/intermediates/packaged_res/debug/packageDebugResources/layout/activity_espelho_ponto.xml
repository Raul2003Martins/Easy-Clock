<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEspelhoPonto"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/espelho_de_ponto"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card Saldo de Horas -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSaldoHoras"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarEspelhoPonto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/saldo_de_horas"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSaldoHorasValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+04:30"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/status_accepted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Histórico de Ponto (Entradas / Saídas / Datas) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoricoPonto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_historico_ponto"
        app:layout_constraintTop_toBottomOf="@id/cardSaldoHoras"
        app:layout_constraintBottom_toTopOf="@id/layoutBotoesPonto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Três botões de ação na parte inferior -->
    <LinearLayout
        android:id="@+id/layoutBotoesPonto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/surface"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitarAjuste"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/solicitar_ajuste_ponto"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarJustificativaFalta"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/enviar_justificativa_falta"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_attach"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSolicitarFolga"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/solicitar_folga_ferias"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textTop" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
