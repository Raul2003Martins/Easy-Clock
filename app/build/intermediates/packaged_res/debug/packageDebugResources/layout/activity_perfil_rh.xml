<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPerfilRh"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            android:elevation="4dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Perfil RH"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivAvatarRh"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/ic_person"
            android:contentDescription="@string/perfil"
            app:tint="@color/primary"
            app:layout_constraintTop_toBottomOf="@id/toolbarPerfilRh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNomePerfilRh"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:hint="@string/nome"
            app:layout_constraintTop_toBottomOf="@id/ivAvatarRh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNomePerfilRh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmailPerfilRh"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:hint="@string/email"
            app:layout_constraintTop_toBottomOf="@id/tilNomePerfilRh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmailPerfilRh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Três botões principais em linha -->
        <LinearLayout
            android:id="@+id/layoutAcoesPerfilRh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilEmailPerfilRh">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEspelhoPontoRh"
                android:layout_width="0dp"
                android:layout_height="87dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/espelho_de_ponto"
                android:textSize="8sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_clock"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVisualizarHoleritesRh"
                android:layout_width="0dp"
                android:layout_height="87dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/visualizar_holerites"
                android:textSize="8sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_download"
                app:iconGravity="textTop" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerTodosColaboradores"
                android:layout_width="0dp"
                android:layout_height="87dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/colaboradores"
                android:textSize="8sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_person"
                app:iconGravity="textTop" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGerarConviteRh"
            android:layout_width="0dp"
            android:layout_height="87dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@string/gerar_convite"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_person"
            app:iconGravity="textTop"
            app:layout_constraintTop_toBottomOf="@id/layoutAcoesPerfilRh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogoutRh"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:text="@string/logout"
            android:textColor="@color/button_danger"
            app:strokeColor="@color/button_danger"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/button_danger"
            app:iconGravity="textStart"
            app:layout_constraintTop_toBottomOf="@id/btnGerarConviteRh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
