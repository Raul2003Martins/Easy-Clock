<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEspelhoPontoRh"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Espelho de Ponto - Funcionário X"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card Saldo de Horas -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSaldoHorasRh"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarEspelhoPontoRh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/saldo_de_horas"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvSaldoHorasValorRh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+04:30"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/status_accepted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Histórico de Ponto -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoricoPontoRh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_historico_ponto"
        app:layout_constraintTop_toBottomOf="@id/cardSaldoHorasRh"
        app:layout_constraintBottom_toTopOf="@id/layoutBotoesEspelhoRh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quatro botões de ação do RH na parte inferior -->
    <LinearLayout
        android:id="@+id/layoutBotoesEspelhoRh"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/surface"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerSolicitacoes"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:text="@string/ver_solicitacoes"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_calendar"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVisualizarJustificativas"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="@string/visualizar_justificativas"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_attach"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarBancoHoras"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:text="@string/editar_banco_horas"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textTop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGerarHolerite"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="@string/gerar_holerite"
            android:textSize="10sp"
            app:cornerRadius="6dp"
            app:icon="@drawable/ic_download"
            app:iconGravity="textTop" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
