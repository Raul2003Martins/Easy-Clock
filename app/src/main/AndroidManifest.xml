<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.easyclock.app">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EasyClockApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.EasyClock">

        <!-- Activities -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.CadastroActivity" />
        <activity android:name=".activities.CadastroEmpresaActivity" />
        <activity android:name=".activities.HomeFuncionarioActivity" />
        <activity android:name=".activities.FaceIdActivity" />
        <activity android:name=".activities.JustificativasActivity" />
        <activity android:name=".activities.PerfilFuncionarioActivity" />
        <activity android:name=".activities.EspelhoPontoActivity" />
        <activity android:name=".activities.AjustePontoActivity" />
        <activity android:name=".activities.HoleriteActivity" />
        <activity android:name=".activities.FolgaFeriasActivity" />

        <!-- RH Activities -->
        <activity android:name=".activities.PerfilRhActivity" />
        <activity android:name=".activities.ColaboradoresActivity" />
        <activity android:name=".activities.HoleriteRhActivity" />
        <activity android:name=".activities.JustificativasFuncionarioActivity" />
        <activity android:name=".activities.EspelhoPontoFuncionarioActivity" />
        <activity android:name=".activities.SolicitacoesFuncionarioActivity" />
        <activity android:name=".activities.SolicitacaoFolgaDetalheActivity" />
        <activity android:name=".activities.SolicitacaoAjusteDetalheActivity" />
    </application>

</manifest>
