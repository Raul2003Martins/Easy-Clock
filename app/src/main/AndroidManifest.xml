        <activity android:name=".EspelhoPontoActivity" />
        <activity android:name=".HoleriteActivity" />
        <activity android:name=".FolgaFeriasActivity" />

        <!-- RH Activities -->
        <activity android:name=".PerfilRhActivity" />
        <activity android:name=".ColaboradoresActivity" />
        <activity android:name=".HoleriteRhActivity" />
        <activity android:name=".JustificativasFuncionarioActivity" />
        <activity android:name=".EspelhoPontoFuncionarioActivity" />
        <activity android:name=".SolicitacoesFuncionarioActivity" />
        <activity android:name=".SolicitacaoFolgaDetalheActivity" />
        <activity android:name=".SolicitacaoAjusteDetalheActivity" />
    </application>

</manifest>
