rules_version = '2';

// ===============================================================
// Assumed Data Model for Easy Clock (Firebase Spark Mode)
// ===============================================================
//
// Collection: empresa/{empresaId}
// Collection: funcionario/{uid}
// Collection: convitesEmpresa/{conviteId}
// Collection: convitesLookup/{codigoHash}
// Collection: cnpjs/{cnpj}
// Collection: auditoriaAprovacoes/{auditId}
// Collection: rateLimits/{rateLimitId}
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getFuncionarioData() {
      return get(/databases/$(database)/documents/funcionario/$(request.auth.uid)).data;
    }

    function hasFuncionarioDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/funcionario/$(request.auth.uid));
    }

    function isUsuarioAtivo() {
      return hasFuncionarioDoc() &&
        getFuncionarioData().status == "ATIVO";
    }

    function isRhAtivo() {
      return isUsuarioAtivo() &&
        getFuncionarioData().perfil == "RH";
    }

    function pertenceAEmpresa(empresaId) {
      return isUsuarioAtivo() &&
        getFuncionarioData().empresaId == empresaId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Collection: funcionario
    // ===============================================================
    match /funcionario/{uid} {
      // 1. Get own profile (even when pending approval or inativo)
      allow get: if isOwner(uid);

      // 2. Active RH can list/get employee documents belonging ONLY to their company
      allow get, list: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      // 3. Create initial profile during registration:
      // Case A: Creating RH account (must create matching new empresa in same batch where responsavelId == uid)
      // Case B: Creating FUNCIONARIO account (status must be PENDENTE_APROVACAO and invite must exist in convitesLookup)
      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        (
          (
            request.resource.data.perfil == "RH" &&
            request.resource.data.status == "ATIVO" &&
            getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == uid
          ) ||
          (
            request.resource.data.perfil == "FUNCIONARIO" &&
            request.resource.data.status == "PENDENTE_APROVACAO" &&
            exists(/databases/$(database)/documents/convitesLookup/$(request.resource.data.codigoHash))
          )
        );

      // 4. Update status: Active RH of the same company can change status from PENDENTE_APROVACAO to ATIVO or RECUSADO.
      // ALL OTHER FIELDS MUST REMAIN UNCHANGED.
      allow update: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId &&
        resource.data.status == "PENDENTE_APROVACAO" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['ATIVO', 'RECUSADO'];
    }

    // ===============================================================
    // Collection: empresa
    // ===============================================================
    match /empresa/{empresaId} {
      allow get: if pertenceAEmpresa(empresaId);

      // Create company during registration
      allow create: if isAuthenticated() &&
        request.resource.data.responsavelId == request.auth.uid &&
        request.resource.data.status == "ATIVA";

      allow list, update, delete: if false;
    }

    // ===============================================================
    // Collection: cnpjs (CNPJ lock for uniqueness)
    // ===============================================================
    match /cnpjs/{cnpj} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/cnpjs/$(cnpj));
      allow list, update, delete: if false;
    }

    // ===============================================================
    // Collection: convitesLookup (Document ID = sha256 hash)
    // ===============================================================
    match /convitesLookup/{codigoHash} {
      // Lookup by exact hash ID allowed during registration before/after auth
      allow get: if true;

      allow create: if isAuthenticated() && (
        (hasFuncionarioDoc() && isRhAtivo() && request.resource.data.empresaId == getFuncionarioData().empresaId) ||
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == request.auth.uid
      );

      allow update: if isAuthenticated();
      allow list, delete: if false;
    }

    // ===============================================================
    // Collection: convitesEmpresa
    // ===============================================================
    match /convitesEmpresa/{conviteId} {
      allow get, list: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      allow create: if isAuthenticated() && (
        (hasFuncionarioDoc() && isRhAtivo() && request.resource.data.empresaId == getFuncionarioData().empresaId) ||
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == request.auth.uid
      );

      allow update, delete: if false;
    }

    // ===============================================================
    // Collection: auditoriaAprovacoes
    // ===============================================================
    match /auditoriaAprovacoes/{auditId} {
      allow create: if isRhAtivo() &&
        request.resource.data.rhUid == request.auth.uid &&
        request.resource.data.empresaId == getFuncionarioData().empresaId;

      allow get, list: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      allow update, delete: if false;
    }

    // ===============================================================
    // Collection: rateLimits
    // ===============================================================
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
