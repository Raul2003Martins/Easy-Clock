rules_version = '2';

// ===============================================================
// Assumed Data Model for Easy Clock (Firebase Spark Mode)
// ===============================================================
//
// Collection: empresa/{empresaId}
// Collection: funcionario/{uid}
// Collection: convitesEmpresa/{conviteId}
// Collection: convitesLookup/{codigoHash}
// Collection: cnpjs/{cnpj}
// Collection: jornadasTrabalho/{jornadaId}
// Collection: controleExpedienteAtivo/{uid}
// Collection: expedientes/{expedienteId} ({uid}_{dataReferencia})
// Collection: ponto/{pontoId} ({uid}_{dataReferencia}_{tipoPonto})
// Collection: solicitacoesAjuste/{solicitacaoId}
// Collection: bancoHoras/{uid}
// Collection: historicoBancoHoras/{historicoId}
// Collection: auditoriaAprovacoes/{auditId}
// Collection: rateLimits/{rateLimitId}
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getFuncionarioData() {
      return get(/databases/$(database)/documents/funcionario/$(request.auth.uid)).data;
    }

    function hasFuncionarioDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/funcionario/$(request.auth.uid));
    }

    function isUsuarioAtivo() {
      return hasFuncionarioDoc() &&
        getFuncionarioData().status == "ATIVO";
    }

    function isRhAtivo() {
      return isUsuarioAtivo() &&
        getFuncionarioData().perfil == "RH";
    }

    function pertenceAEmpresa(empresaId) {
      return isUsuarioAtivo() &&
        getFuncionarioData().empresaId == empresaId;
    }

    function funcionarioPertenceAEmpresaRh(targetUid) {
      return exists(/databases/$(database)/documents/funcionario/$(targetUid)) &&
        get(/databases/$(database)/documents/funcionario/$(targetUid)).data.empresaId == getFuncionarioData().empresaId;
    }

    function pontoExiste(uid, dataRef, tipo) {
      return exists(/databases/$(database)/documents/ponto/$(uid + '_' + dataRef + '_' + tipo));
    }

    function expedienteExiste(uid, dataRef) {
      return exists(/databases/$(database)/documents/expedientes/$(uid + '_' + dataRef));
    }

    function temExpedienteAtivoAbilidade(uid) {
      return exists(/databases/$(database)/documents/controleExpedienteAtivo/$(uid)) &&
        get(/databases/$(database)/documents/controleExpedienteAtivo/$(uid)).data.estado == "ABERTO";
    }

    function formatDigit(n) {
      return n < 10 ? "0" + string(n) : string(n);
    }

    function dataServidorUtc(t) {
      return string(t.year()) + "-" + formatDigit(t.month()) + "-" + formatDigit(t.day());
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Collection: bancoHoras/{uid}
    match /bancoHoras/{uid} {
      allow get: if isOwner(uid) ||
        (isRhAtivo() && funcionarioPertenceAEmpresaRh(uid));

      allow list: if isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId;

      allow create, update: if isUsuarioAtivo() &&
        (
          (
            request.auth.uid == uid &&
            request.resource.data.empresaId == getFuncionarioData().empresaId
          ) ||
          (
            isRhAtivo() &&
            funcionarioPertenceAEmpresaRh(uid)
          )
        );

      allow delete: if false;
    }

    // Collection: historicoBancoHoras/{historicoId}
    match /historicoBancoHoras/{historicoId} {
      allow get, list: if isUsuarioAtivo() &&
        (
          resource.data.funcionarioId == request.auth.uid ||
          (isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId)
        );

      allow create: if isUsuarioAtivo() &&
        request.resource.data.tipo in ['AUTOMATICO_EXPEDIENTE', 'AJUSTE_MANUAL_RH'] &&
        (
          (
            request.resource.data.tipo == "AUTOMATICO_EXPEDIENTE" &&
            request.resource.data.funcionarioId == request.auth.uid &&
            request.resource.data.empresaId == getFuncionarioData().empresaId
          ) ||
          (
            request.resource.data.tipo == "AJUSTE_MANUAL_RH" &&
            isRhAtivo() &&
            request.resource.data.empresaId == getFuncionarioData().empresaId &&
            request.resource.data.justificativa is string &&
            request.resource.data.justificativa.size() >= 5
          )
        );

      allow update, delete: if false;
    }

    // Collection: solicitacoesAjuste/{solicitacaoId}
    match /solicitacoesAjuste/{solicitacaoId} {
      allow get, list: if isOwner(resource.data.funcionarioId) ||
        (isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId);

      allow create: if isUsuarioAtivo() &&
        request.resource.data.funcionarioId == request.auth.uid &&
        request.resource.data.empresaId == getFuncionarioData().empresaId &&
        request.resource.data.status == "PENDENTE" &&
        request.resource.data.tipoPonto in ['ENTRADA', 'SAIDA_ALMOCO', 'RETORNO_ALMOCO', 'SAIDA'] &&
        request.resource.data.motivo is string &&
        request.resource.data.motivo.size() >= 10 &&
        request.resource.data.motivo.size() <= 300 &&
        request.resource.data.horarioAjustado.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        request.resource.data.dataReferencia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      allow update: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId &&
        resource.data.status == "PENDENTE" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'dataResposta', 'rhUid', 'respostaRh']) &&
        request.resource.data.status in ['APROVADO', 'RECUSADO'] &&
        request.resource.data.rhUid == request.auth.uid;

      allow delete: if false;
    }

    // Collection: controleExpedienteAtivo/{uid}
    match /controleExpedienteAtivo/{uid} {
      allow get: if isOwner(uid) ||
        (isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId);

      allow create, update: if isUsuarioAtivo() &&
        uid == request.auth.uid &&
        request.resource.data.funcionarioId == request.auth.uid &&
        request.resource.data.empresaId == getFuncionarioData().empresaId &&
        request.resource.data.keys().hasOnly(['funcionarioId', 'empresaId', 'expedienteId', 'dataReferencia', 'estado', 'atualizadoEm']) &&
        (
          (
            request.resource.data.estado == "ABERTO" &&
            (!exists(/databases/$(database)/documents/controleExpedienteAtivo/$(uid)) || resource.data.estado == "CONCLUIDO") &&
            getAfter(/databases/$(database)/documents/expedientes/$(request.resource.data.expedienteId)).data.proximaMarcacao == "SAIDA_ALMOCO" &&
            getAfter(/databases/$(database)/documents/ponto/$(request.resource.data.expedienteId + '_ENTRADA')).data.tipoPonto == "ENTRADA"
          ) ||
          (
            request.resource.data.estado == "ABERTO" &&
            resource.data.estado == "ABERTO" &&
            request.resource.data.expedienteId == resource.data.expedienteId &&
            request.resource.data.dataReferencia == resource.data.dataReferencia
          ) ||
          (
            request.resource.data.estado == "CONCLUIDO" &&
            resource.data.estado == "ABERTO" &&
            request.resource.data.expedienteId == resource.data.expedienteId &&
            request.resource.data.dataReferencia == resource.data.dataReferencia &&
            getAfter(/databases/$(database)/documents/expedientes/$(resource.data.expedienteId)).data.concluido == true &&
            getAfter(/databases/$(database)/documents/ponto/$(resource.data.expedienteId + '_SAIDA')).data.tipoPonto == "SAIDA"
          )
        );

      allow delete: if false;
    }

    // Collection: funcionario
    match /funcionario/{uid} {
      allow get: if isOwner(uid);

      allow get, list: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      allow create: if isOwner(uid) &&
        request.resource.data.uid == uid &&
        (
          (
            request.resource.data.perfil == "RH" &&
            request.resource.data.status == "ATIVO" &&
            getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == uid
          ) ||
          (
            request.resource.data.perfil == "FUNCIONARIO" &&
            request.resource.data.status == "PENDENTE_APROVACAO" &&
            exists(/databases/$(database)/documents/convitesLookup/$(request.resource.data.codigoHash)) &&
            get(/databases/$(database)/documents/convitesLookup/$(request.resource.data.codigoHash)).data.ativo == true
          )
        );

      allow update: if (
        (
          isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['reconhecimentoFacialCadastrado', 'fotoPerfilPath'])
        ) ||
        (
          isRhAtivo() &&
          'empresaId' in resource.data &&
          resource.data.empresaId == getFuncionarioData().empresaId &&
          (
            (
              resource.data.status == "PENDENTE_APROVACAO" &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
              request.resource.data.status in ['ATIVO', 'RECUSADO']
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jornadaId']) &&
              (
                request.resource.data.jornadaId == "" ||
                request.resource.data.jornadaId == null ||
                (
                  exists(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)) &&
                  get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.empresaId == resource.data.empresaId &&
                  get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.ativo == true
                )
              )
            )
          )
        )
      );
    }

    // Collection: expedientes ({uid}_{dataReferencia})
    match /expedientes/{expedienteId} {
      allow get: if isOwner(resource.data.funcionarioId) ||
        (isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId);

      allow create: if isUsuarioAtivo() &&
        request.resource.data.funcionarioId == request.auth.uid &&
        request.resource.data.empresaId == getFuncionarioData().empresaId &&
        request.resource.data.dataReferencia == dataServidorUtc(request.time) &&
        expedienteId == request.auth.uid + "_" + request.resource.data.dataReferencia &&
        !expedienteExiste(request.auth.uid, request.resource.data.dataReferencia) &&
        !temExpedienteAtivoAbilidade(request.auth.uid) &&
        request.resource.data.jornadaId == getFuncionarioData().jornadaId &&
        exists(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)) &&
        get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.empresaId == getFuncionarioData().empresaId &&
        get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.ativo == true &&
        request.resource.data.jornadaSnapshot.entrada == get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.entrada &&
        request.resource.data.jornadaSnapshot.saidaAlmoco == get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.saidaAlmoco &&
        request.resource.data.jornadaSnapshot.retornoAlmoco == get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.retornoAlmoco &&
        request.resource.data.jornadaSnapshot.saida == get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.saida &&
        request.resource.data.jornadaSnapshot.cargaHorariaMinutos == get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.cargaHorariaMinutos &&
        request.resource.data.jornadaSnapshot.toleranciaMinutos == get(/databases/$(database)/documents/jornadasTrabalho/$(request.resource.data.jornadaId)).data.toleranciaMinutos &&
        request.resource.data.proximaMarcacao == "SAIDA_ALMOCO" &&
        request.resource.data.concluido == false &&
        getAfter(/databases/$(database)/documents/ponto/$(expedienteId + '_ENTRADA')).data.tipoPonto == "ENTRADA" &&
        getAfter(/databases/$(database)/documents/controleExpedienteAtivo/$(request.auth.uid)).data.estado == "ABERTO";

      allow update: if isUsuarioAtivo() &&
        resource.data.funcionarioId == request.auth.uid &&
        resource.data.concluido == false &&
        request.resource.data.funcionarioId == request.auth.uid &&
        request.resource.data.empresaId == resource.data.empresaId &&
        request.resource.data.jornadaId == resource.data.jornadaId &&
        request.resource.data.dataReferencia == resource.data.dataReferencia &&
        (
          (
            resource.data.proximaMarcacao == "SAIDA_ALMOCO" &&
            request.resource.data.proximaMarcacao == "RETORNO_ALMOCO" &&
            request.resource.data.concluido == false &&
            getAfter(/databases/$(database)/documents/ponto/$(expedienteId + '_SAIDA_ALMOCO')).data.tipoPonto == "SAIDA_ALMOCO"
          ) ||
          (
            resource.data.proximaMarcacao == "RETORNO_ALMOCO" &&
            request.resource.data.proximaMarcacao == "SAIDA" &&
            request.resource.data.concluido == false &&
            getAfter(/databases/$(database)/documents/ponto/$(expedienteId + '_RETORNO_ALMOCO')).data.tipoPonto == "RETORNO_ALMOCO"
          ) ||
          (
            resource.data.proximaMarcacao == "SAIDA" &&
            request.resource.data.proximaMarcacao == "CONCLUIDO" &&
            request.resource.data.concluido == true &&
            getAfter(/databases/$(database)/documents/ponto/$(expedienteId + '_SAIDA')).data.tipoPonto == "SAIDA"
          )
        );

      allow delete: if false;
    }

    // Collection: ponto ({uid}_{dataReferencia}_{tipoPonto})
    match /ponto/{pontoId} {
      allow get, list: if isOwner(resource.data.funcionarioId) ||
        (isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId);

      allow create: if isUsuarioAtivo() &&
        request.resource.data.funcionarioId == request.auth.uid &&
        request.resource.data.empresaId == getFuncionarioData().empresaId &&
        request.resource.data.dataHora == request.time &&
        request.resource.data.tipoPonto in ['ENTRADA', 'SAIDA_ALMOCO', 'RETORNO_ALMOCO', 'SAIDA'] &&
        request.resource.data.status == "VALIDO" &&
        pontoId == request.auth.uid + "_" + request.resource.data.dataReferencia + "_" + request.resource.data.tipoPonto &&
        (
          (
            request.resource.data.tipoPonto == "ENTRADA" &&
            request.resource.data.dataReferencia == dataServidorUtc(request.time) &&
            !pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "ENTRADA") &&
            getAfter(/databases/$(database)/documents/expedientes/$(request.auth.uid + '_' + request.resource.data.dataReferencia)).data.jornadaSnapshot.cargaHorariaMinutos == request.resource.data.jornadaSnapshot.cargaHorariaMinutos
          ) ||
          (
            request.resource.data.tipoPonto == "SAIDA_ALMOCO" &&
            pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "ENTRADA") &&
            !pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "SAIDA_ALMOCO") &&
            get(/databases/$(database)/documents/expedientes/$(request.auth.uid + '_' + request.resource.data.dataReferencia)).data.jornadaSnapshot.cargaHorariaMinutos == request.resource.data.jornadaSnapshot.cargaHorariaMinutos
          ) ||
          (
            request.resource.data.tipoPonto == "RETORNO_ALMOCO" &&
            pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "SAIDA_ALMOCO") &&
            !pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "RETORNO_ALMOCO") &&
            get(/databases/$(database)/documents/expedientes/$(request.auth.uid + '_' + request.resource.data.dataReferencia)).data.jornadaSnapshot.cargaHorariaMinutos == request.resource.data.jornadaSnapshot.cargaHorariaMinutos
          ) ||
          (
            request.resource.data.tipoPonto == "SAIDA" &&
            pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "RETORNO_ALMOCO") &&
            !pontoExiste(request.auth.uid, request.resource.data.dataReferencia, "SAIDA") &&
            get(/databases/$(database)/documents/expedientes/$(request.auth.uid + '_' + request.resource.data.dataReferencia)).data.jornadaSnapshot.cargaHorariaMinutos == request.resource.data.jornadaSnapshot.cargaHorariaMinutos
          )
        );

      allow update, delete: if false;
    }

    // Collection: jornadasTrabalho
    match /jornadasTrabalho/{jornadaId} {
      allow get, list: if pertenceAEmpresa(resource.data.empresaId);

      allow create: if isRhAtivo() &&
        request.resource.data.empresaId == getFuncionarioData().empresaId &&
        request.resource.data.nome is string &&
        request.resource.data.nome.size() > 0 &&
        request.resource.data.cargaHorariaMinutos is number &&
        request.resource.data.cargaHorariaMinutos > 0 &&
        request.resource.data.toleranciaMinutos is number &&
        request.resource.data.toleranciaMinutos >= 0 &&
        request.resource.data.diasSemana is list &&
        request.resource.data.diasSemana.size() > 0;

      allow update: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId &&
        request.resource.data.empresaId == resource.data.empresaId;

      allow delete: if false;
    }

    // Collection: empresa
    match /empresa/{empresaId} {
      allow get: if pertenceAEmpresa(empresaId);

      allow create: if isAuthenticated() &&
        request.resource.data.responsavelId == request.auth.uid &&
        request.resource.data.status == "ATIVA";

      allow update: if isRhAtivo() &&
        pertenceAEmpresa(empresaId) &&
        request.resource.data.responsavelId == resource.data.responsavelId &&
        request.resource.data.status == resource.data.status;

      allow list, delete: if false;
    }

    // Collection: cnpjs
    match /cnpjs/{cnpj} {
      allow get: if isAuthenticated();

      allow create: if isAuthenticated() &&
        !exists(/databases/$(database)/documents/cnpjs/$(cnpj)) &&
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.cnpj == cnpj &&
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.status == "ATIVA";

      allow list, update, delete: if false;
    }

    // Collection: convitesLookup (Document ID = sha256 hash)
    match /convitesLookup/{codigoHash} {
      allow get: if true;

      allow create: if isAuthenticated() && (
        (hasFuncionarioDoc() && isRhAtivo() && request.resource.data.empresaId == getFuncionarioData().empresaId) ||
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == request.auth.uid
      );

      allow update: if (
        (hasFuncionarioDoc() && isRhAtivo() && resource.data.empresaId == getFuncionarioData().empresaId) ||
        (
          isAuthenticated() &&
          resource.data.ativo == true &&
          (!('expiraEm' in resource.data) || resource.data.expiraEm == null || resource.data.expiraEm > request.time) &&
          (!('limiteUsos' in resource.data) || resource.data.limiteUsos == null || resource.data.quantidadeUsos < resource.data.limiteUsos) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantidadeUsos']) &&
          request.resource.data.quantidadeUsos == resource.data.quantidadeUsos + 1 &&
          getAfter(/databases/$(database)/documents/funcionario/$(request.auth.uid)).data.codigoHash == codigoHash &&
          getAfter(/databases/$(database)/documents/funcionario/$(request.auth.uid)).data.empresaId == resource.data.empresaId &&
          getAfter(/databases/$(database)/documents/funcionario/$(request.auth.uid)).data.perfil == "FUNCIONARIO" &&
          getAfter(/databases/$(database)/documents/funcionario/$(request.auth.uid)).data.status == "PENDENTE_APROVACAO"
        )
      );

      allow list, delete: if false;
    }

    // Collection: convitesEmpresa
    match /convitesEmpresa/{conviteId} {
      allow get, list: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      allow create: if isAuthenticated() && (
        (hasFuncionarioDoc() && isRhAtivo() && request.resource.data.empresaId == getFuncionarioData().empresaId) ||
        getAfter(/databases/$(database)/documents/empresa/$(request.resource.data.empresaId)).data.responsavelId == request.auth.uid
      );

      allow update: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      allow delete: if false;
    }

    // Collection: auditoriaAprovacoes
    match /auditoriaAprovacoes/{auditId} {
      allow create: if isRhAtivo() &&
        request.resource.data.rhUid == request.auth.uid &&
        request.resource.data.empresaId == getFuncionarioData().empresaId;

      allow get, list: if isRhAtivo() &&
        resource.data.empresaId == getFuncionarioData().empresaId;

      allow update, delete: if false;
    }

    // Collection: rateLimits
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
